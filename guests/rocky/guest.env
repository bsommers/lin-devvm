# shellcheck shell=bash
# shellcheck disable=SC2034
# Rocky Linux 10 GenericCloud (Base) x86_64 qcow2. Sourced by config.env.
ROCKY_REL="${ROCKY_REL:-10}"
_rocky_dir="https://dl.rockylinux.org/pub/rocky/$ROCKY_REL/images/x86_64"
GUEST_DIR="${GUEST_DIR:-$HERE/guests/rocky}"
GUEST_LABEL="Rocky Linux $ROCKY_REL"
GUEST_FAMILY=rhel
OS_VARIANT="${OS_VARIANT:-rocky-unknown}"
DESKTOP=0
DESKTOP_ENV=""
GUEST_DISK_GB=20
IMAGE_FILE="${IMAGE_FILE:-Rocky-$ROCKY_REL-GenericCloud-Base.latest.x86_64.qcow2}"
IMAGE_URL="${IMAGE_URL:-$_rocky_dir/$IMAGE_FILE}"
IMAGE_SUMS="${IMAGE_SUMS:-$_rocky_dir/$IMAGE_FILE.CHECKSUM}"   # per-file 'SHA256 (name) = hash'
GUEST_BANNER="Rocky $ROCKY_REL GenericCloud; cloud-init creates $ADMIN_USER and runs the devvm provision script."
