# shellcheck shell=bash
# shellcheck disable=SC2034
# Kubuntu 24.04: Ubuntu noble cloud image + kubuntu-desktop (KDE Plasma) installed by guests/kubuntu/setup.sh.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/kubuntu}"
GUEST_LABEL="Kubuntu 24.04 (KDE)"
GUEST_FAMILY=debian
OS_VARIANT="${OS_VARIANT:-ubuntu24.04}"
DESKTOP=1
DESKTOP_ENV=kde
GUEST_DISK_GB=40
IMAGE_URL="${IMAGE_URL:-https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img}"
IMAGE_FILE="${IMAGE_FILE:-noble-server-cloudimg-amd64.img}"
IMAGE_SUMS="${IMAGE_SUMS:-https://cloud-images.ubuntu.com/noble/current/SHA256SUMS}"
GUEST_BANNER="Kubuntu = Ubuntu cloud image + kubuntu-desktop (SDDM/Plasma); first provision is slow (~1.5 GB of packages)."
