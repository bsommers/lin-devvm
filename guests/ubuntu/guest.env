# shellcheck shell=bash
# shellcheck disable=SC2034
# Ubuntu 24.04 LTS (noble) cloud image. Sourced by config.env.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/ubuntu}"
GUEST_LABEL="Ubuntu 24.04"
GUEST_FAMILY=debian
OS_VARIANT="${OS_VARIANT:-ubuntu24.04}"
DESKTOP=0
DESKTOP_ENV=""
GUEST_DISK_GB=20
IMAGE_URL="${IMAGE_URL:-https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img}"
IMAGE_FILE="${IMAGE_FILE:-noble-server-cloudimg-amd64.img}"
IMAGE_SUMS="${IMAGE_SUMS:-https://cloud-images.ubuntu.com/noble/current/SHA256SUMS}"
GUEST_BANNER="Ubuntu 24.04 cloud image; cloud-init creates $ADMIN_USER and runs the devvm provision script."
