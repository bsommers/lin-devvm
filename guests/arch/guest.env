# shellcheck shell=bash
# shellcheck disable=SC2034
# Arch Linux official cloud image (rolling, 'latest'). Sourced by config.env.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/arch}"
GUEST_LABEL="Arch Linux"
GUEST_FAMILY=arch
OS_VARIANT="${OS_VARIANT:-archlinux}"
DESKTOP=0
DESKTOP_ENV=""
GUEST_DISK_GB=20
_arch_dir="https://geo.mirror.pkgbuild.com/images/latest"
IMAGE_URL="${IMAGE_URL:-$_arch_dir/Arch-Linux-x86_64-cloudimg.qcow2}"
IMAGE_FILE="${IMAGE_FILE:-Arch-Linux-x86_64-cloudimg.qcow2}"
IMAGE_SUMS="${IMAGE_SUMS:-$_arch_dir/Arch-Linux-x86_64-cloudimg.qcow2.SHA256}"
GUEST_BANNER="Arch cloud image (rolling); cloud-init creates $ADMIN_USER; first provision does a full -Syu."
