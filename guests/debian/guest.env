# shellcheck shell=bash
# shellcheck disable=SC2034
# Debian 13 (trixie) genericcloud x86_64 qcow2. Sourced by config.env.
# NOTE: Debian publishes only SHA512SUMS; lib/images.sh verifies 128-hex (SHA-512) checksums as well as SHA-256.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/debian}"
GUEST_LABEL="Debian 13 (trixie)"
GUEST_FAMILY=debian
OS_VARIANT="${OS_VARIANT:-debian13}"
DESKTOP=0
DESKTOP_ENV=""
GUEST_DISK_GB=20
IMAGE_URL="${IMAGE_URL:-https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2}"
IMAGE_FILE="${IMAGE_FILE:-debian-13-genericcloud-amd64.qcow2}"
IMAGE_SUMS="${IMAGE_SUMS:-https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS}"  
GUEST_BANNER="Debian 13 genericcloud image; cloud-init creates $ADMIN_USER and runs the devvm provision script."
