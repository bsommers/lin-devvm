# shellcheck shell=bash
# shellcheck disable=SC2034
# openSUSE Tumbleweed Minimal-VM (cloud-init flavour) qcow2. Sourced by config.env.
# Rolling: the unversioned file name is re-published on every snapshot, so the cached copy keeps its
# checksum only until upstream updates it; delete the cached image to refresh.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/opensuse}"
GUEST_LABEL="openSUSE Tumbleweed"
GUEST_FAMILY=suse
OS_VARIANT="${OS_VARIANT:-opensusetumbleweed}"
DESKTOP=0
DESKTOP_ENV=""
GUEST_DISK_GB=20
_suse_dir="https://download.opensuse.org/tumbleweed/appliances"
IMAGE_FILE="${IMAGE_FILE:-openSUSE-Tumbleweed-Minimal-VM.x86_64-Cloud.qcow2}"
IMAGE_URL="${IMAGE_URL:-$_suse_dir/$IMAGE_FILE}"
IMAGE_SUMS="${IMAGE_SUMS:-$_suse_dir/$IMAGE_FILE.sha256}"
GUEST_BANNER="openSUSE Tumbleweed Minimal-VM (cloud-init); cloud-init creates $ADMIN_USER and runs the devvm provision script."
