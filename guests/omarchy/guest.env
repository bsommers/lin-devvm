# shellcheck shell=bash
# shellcheck disable=SC2034
# Omarchy (DHH's Arch + Hyprland distro) on a VM. NO Omarchy cloud image exists (it ships only as an
# interactive ISO installer), so this boots the official Arch cloud image and guests/omarchy/setup.sh
# runs Omarchy's own boot script (omarchy.org/install) non-interactively. Best effort / not officially
# supported: Omarchy officially targets its ISO (archinstall + limine + LUKS). The script-on-Arch path
# may drift between Omarchy releases. Hyprland needs GPU acceleration; virtio-gpu 3D is usable but slow.
GUEST_DIR="${GUEST_DIR:-$HERE/guests/omarchy}"
GUEST_LABEL="Omarchy (Arch + Hyprland)"
GUEST_FAMILY=arch
OS_VARIANT="${OS_VARIANT:-archlinux}"
# Arch images are not Secure Boot signed: boot UEFI with secure-boot disabled.
UEFI_BOOT="${UEFI_BOOT:-uefi,firmware.feature0.name=secure-boot,firmware.feature0.enabled=no}"
DESKTOP=1
DESKTOP_ENV=hyprland
GUEST_DISK_GB=40
_arch_dir="https://geo.mirror.pkgbuild.com/images/latest"
IMAGE_URL="${IMAGE_URL:-$_arch_dir/Arch-Linux-x86_64-cloudimg.qcow2}"
IMAGE_FILE="${IMAGE_FILE:-Arch-Linux-x86_64-cloudimg.qcow2}"
IMAGE_SUMS="${IMAGE_SUMS:-$_arch_dir/Arch-Linux-x86_64-cloudimg.qcow2.SHA256}"
GUEST_BANNER="Omarchy = Arch cloud image + upstream Omarchy installer (best effort, 20-40 min); log in graphically after it finishes."
