# shellcheck shell=bash
# shellcheck disable=SC2034
# Fedora 45 Cloud Base Generic x86_64 qcow2. Sourced by config.env.
FEDORA_REL="${FEDORA_REL:-45}"
FEDORA_BUILD="${FEDORA_BUILD:-1.4}"          # compose id; bump together with FEDORA_REL
_fedora_dir="https://dl.fedoraproject.org/pub/fedora/linux/releases/$FEDORA_REL/Cloud/x86_64/images"
GUEST_DIR="${GUEST_DIR:-$HERE/guests/fedora}"
GUEST_LABEL="Fedora $FEDORA_REL"
GUEST_FAMILY=rhel
OS_VARIANT="${OS_VARIANT:-fedora-unknown}"   # libosinfo lags releases; always valid
DESKTOP=0
DESKTOP_ENV=""
GUEST_DISK_GB=20
IMAGE_FILE="${IMAGE_FILE:-Fedora-Cloud-Base-Generic-$FEDORA_REL-$FEDORA_BUILD.x86_64.qcow2}"
IMAGE_URL="${IMAGE_URL:-$_fedora_dir/$IMAGE_FILE}"
IMAGE_SUMS="${IMAGE_SUMS:-$_fedora_dir/Fedora-Cloud-$FEDORA_REL-$FEDORA_BUILD-x86_64-CHECKSUM}"   # PGP-clearsigned; BSD-style lines parse fine
GUEST_BANNER="Fedora $FEDORA_REL Cloud Base; cloud-init creates $ADMIN_USER and runs the devvm provision script."
