# shellcheck shell=bash
# lin-devvm configuration (sourced by the scripts; override any value via environment).
# GUEST selects guests/<GUEST>/guest.env; ROLE selects what gets installed on top (roles/<ROLE>.sh).
HERE="${HERE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
# shellcheck source=lib/common.sh
source "$HERE/lib/common.sh"
GUEST="${GUEST:-ubuntu}"
ROLE="${ROLE:-dev}"                       # dev = interactive workstation, ai = dedicated AI-coding VM (see roles/)
WEB="${WEB:-0}"                           # 1: also install the browser IDE (code-server), reachable only via SSH tunnel
VM_NAME="${VM_NAME:-lin-$GUEST-$ROLE}"
VM_DIR="${VM_DIR:-$HOME/vms/$VM_NAME}"    # state: disk overlay, seed ISO, known_hosts
ADMIN_USER="${ADMIN_USER:-dev}"           # interactive human user
AGENT_USER="${AGENT_USER:-agent}"         # unprivileged user that runs unattended AI agents (ROLE=ai)
SSH_KEY="${SSH_KEY:-$HOME/.ssh/id_lindevvm}"   # ed25519, generated by provision.sh if missing
WEB_PASS="${WEB_PASS:-devvm}"             # plain password for the web IDE; lab only, never exposed beyond 127.0.0.1 + SSH
WEB_PORT_GUEST="${WEB_PORT_GUEST:-8080}"  # code-server listens on 127.0.0.1:$WEB_PORT_GUEST inside the guest
WEB_PORT="${WEB_PORT:-$((18080 + $(vm_slot "$VM_NAME")))}"   # host-side tunnel port opened by `vm.sh web`

if [[ ! -r "$HERE/guests/$GUEST/guest.env" ]]; then
  echo "unknown GUEST '$GUEST' (no guests/$GUEST/guest.env); available: $(ls "$HERE/guests" | tr '\n' ' ')" >&2
  exit 1
fi
if [[ ! -r "$HERE/roles/$ROLE.sh" ]]; then
  echo "unknown ROLE '$ROLE' (no roles/$ROLE.sh)" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$HERE/guests/$GUEST/guest.env"
IMAGE_CACHE="${IMAGE_CACHE:-$HOME/.cache/lin-devvm/images}"
VM_DISK_GB="${VM_DISK_GB:-${GUEST_DISK_GB:-40}}"
DATA_DISK_GB="${DATA_DISK_GB:-0}"         # >0: persistent /work disk that survives `vm.sh reset` (default 20 for ROLE=ai)
[[ "$ROLE" == ai && "$DATA_DISK_GB" == 0 ]] && DATA_DISK_GB=20
if [[ "$ROLE" == ai ]]; then VM_RAM_MB="${VM_RAM_MB:-12288}"; VM_VCPUS="${VM_VCPUS:-6}"; else VM_RAM_MB="${VM_RAM_MB:-8192}"; VM_VCPUS="${VM_VCPUS:-4}"; fi
[[ "${DESKTOP:-0}" == 1 ]] && VM_RAM_MB="${VM_RAM_MB_DESKTOP:-8192}"   # GUEST_DESKTOP guests need a floor
LIBVIRT_URI="${LIBVIRT_URI:-qemu:///session}"   # rootless; no sudo
VM_SLOT="$(vm_slot "$VM_NAME")"
SSH_PORT="${SSH_PORT:-$((2300 + VM_SLOT))}"     # host 127.0.0.1:SSH_PORT -> guest:22
VM_MAC="${VM_MAC:-$(vm_mac "$VM_NAME")}"
